      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst imageUrl = item['Product image URL'] || item['Image Src'] || item['Image URL'] || '';\nconst rawInfo = item['Description'] || item['Title'] || '';\nlet category = String(item['Product category'] || item['Type'] || '').trim();\nconst vendor = item['Vendor'] || item['Brand'] || '';\nconst sku = item['SKU'] || item['Variant SKU'] || '';\nconst rowNumber = item.row_number ?? item.__rowNumber ?? item.__row ?? null;\n\nif (category.startsWith('#') || /error/i.test(category)) {\n  category = '';\n}\n\nif (!imageUrl) {\n  throw new Error('Validation Error: Missing Product image URL');\n}\nif (!rawInfo) {\n  throw new Error('Validation Error: Missing Description or Title');\n}\nif (!sku) {\n  throw new Error('Validation Error: Missing SKU — required to find and update the correct sheet row');\n}\n\nreturn [{\n  json: {\n    ...item,\n    row_number: rowNumber,\n    validated_image_url: imageUrl,\n    validated_raw_info: rawInfo,\n    validated_category: category,\n    validated_vendor: vendor,\n    validated_sku: sku,\n    validated_price: item['Price'] || item['Variant Price'] || null,\n    validated_inventory: item['Inventory quantity'] || item['Variant Inventory Qty'] || item['Inventory Qty'] || null\n  }\n}];"
