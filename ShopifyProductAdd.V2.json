    {
      "parameters": {
        "jsCode": "const imgbb = $('HTTP Request1').first().json;\nconst imageUrl = imgbb?.data?.url;\n\nif (!imageUrl) {\n  throw new Error('ImgBB upload did not return data.url — check ImgBB API key and HTTP Request1 response');\n}\n\nconst maxAttempts = 15;\nconst delayMs = 4000;\nlet lastError = 'unknown';\n\nfor (let attempt = 1; attempt <= maxAttempts; attempt++) {\n  try {\n    const response = await this.helpers.httpRequest({\n      method: 'GET',\n      url: imageUrl,\n      returnFullResponse: true,\n      timeout: 15000,\n      headers: {\n        Range: 'bytes=0-0',\n        'User-Agent': 'n8n-shopify-cdn-probe/1.0',\n      },\n      ignoreHttpStatusErrors: true,\n    });\n\n    const status = response.statusCode ?? response.status ?? 0;\n    if (status >= 200 && status < 400) {\n      return [{\n        json: {\n          image_url: imageUrl,\n          cdn_ready: true,\n          cdn_attempts: attempt,\n          cdn_checked_at: new Date().toISOString(),\n        },\n      }];\n    }\n\n    lastError = `HTTP ${status} on attempt ${attempt}`;\n  } catch (err) {\n    lastError = err.message || String(err);\n  }\n\n  if (attempt < maxAttempts) {\n    await new Promise((resolve) => setTimeout(resolve, delayMs));\n  }\n}\n\nthrow new Error(\n  `Image CDN not ready after ${maxAttempts} attempts (~${Math.round((maxAttempts - 1) * delayMs / 1000)}s). ` +\n  `OpenAI could not fetch: ${imageUrl}. Last error: ${lastError}`\n);"
      },
