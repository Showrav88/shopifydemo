    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst imageUrl = item['Product image URL'] || item['Image Src'] || item['Image URL'] || '';\nconst rawInfo = item['Description'] || item['Title'] || '';\nconst category = item['Product category'] || item['Type'] || '';\nconst vendor = item['Vendor'] || item['Brand'] || '';\n\nif (!imageUrl) {\n  throw new Error('Validation Error: Missing Product image URL');\n}\nif (!rawInfo) {\n  throw new Error('Validation Error: Missing Description or Title');\n}\n\nreturn [{\n  json: {\n    ...item,\n    validated_image_url: imageUrl,\n    validated_raw_info: rawInfo,\n    validated_category: category,\n    validated_vendor: vendor,\n    validated_price: item['Price'] || item['Variant Price'] || null,\n    validated_sku: item['SKU'] || item['Variant SKU'] || null,\n    validated_inventory: item['Inventory quantity'] || item['Variant Inventory Qty'] || item['Inventory Qty'] || null\n  }\n}];"
      },
